<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>MVP TV Live Broadcast Overlay</title>
    <style>
        :root {
            --bg-dark: #0a0a0a;
            --espn-red: #cc0000;
            --gold: #ffcc00;
            --text-white: #ffffff;
            --text-gray: #8e8e93;
            --cyan: #00f3ff;
        }

        body {
            font-family: 'Arial Black', Impact, sans-serif;
            margin: 0;
            padding: 0;
            background-color: #00ff00; /* Solid Chroma Key Green */
            color: var(--text-white);
            overflow: hidden;
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
        }

        #broadcast-banner {
            display: flex;
            height: 60px;
            background: var(--bg-dark);
            border: 2px solid #222;
            box-shadow: 0 10px 25px rgba(0,0,0,0.9);
            align-items: center;
            font-size: 18px;
            position: relative;
            transition: opacity 0.3s ease;
        }

        #event-header {
            position: absolute;
            top: -26px;
            left: 0;
            background: var(--espn-red);
            color: white;
            font-size: 11px;
            padding: 4px 15px;
            text-transform: uppercase;
            font-family: Arial, sans-serif;
            font-weight: bold;
            letter-spacing: 1.5px;
            border-top-right-radius: 4px;
            border-top-left-radius: 4px;
            height: 18px;
            display: flex;
            align-items: center;
        }

        #commentator-bar {
            position: absolute;
            bottom: -22px;
            right: 0;
            background: rgba(10, 10, 10, 0.95);
            border: 1px solid #222;
            color: var(--text-gray);
            font-size: 10px;
            padding: 3px 12px;
            font-family: Arial, sans-serif;
            font-weight: bold;
            letter-spacing: 1px;
            border-bottom-left-radius: 4px;
            border-bottom-right-radius: 4px;
        }

        .logo-block {
            width: 70px;
            height: 100%;
            background: #111;
            display: flex;
            align-items: center;
            justify-content: center;
            border-right: 2px solid #222;
            overflow: hidden;
        }

        .logo-block img {
            max-width: 90%;
            max-height: 90%;
            object-fit: contain;
        }

        .game-icon-block {
            width: 65px; /* Widened slightly to accommodate larger size */
            height: 100%;
            background: #1c1c1e;
            display: flex;
            align-items: center;
            justify-content: center;
            border-right: 2px solid #222;
            font-size: 32px; /* Increased font size */
            text-shadow: 0 0 12px rgba(255, 204, 0, 0.8), 0 0 4px #ff3300; /* Colorful vibrant aura */
            overflow: hidden;
        }

        .game-icon-block img {
            max-width: 85%;
            max-height: 85%;
            object-fit: contain;
        }

        .team-section {
            display: flex;
            align-items: center;
            height: 100%;
            position: relative;
        }

        .team-meta {
            display: flex;
            flex-direction: column;
            justify-content: center;
            padding: 0 15px;
            min-width: 180px;
        }

        .team-name {
            font-size: 11px;
            color: var(--text-gray);
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .player-name {
            font-size: 18px;
            color: var(--text-white);
            text-transform: uppercase;
        }

        .active-dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: var(--cyan);
            box-shadow: 0 0 8px var(--cyan);
            margin-right: 8px;
            display: inline-block;
            opacity: 0;
            transition: opacity 0.2s ease;
        }

        .active-dot.active {
            opacity: 1;
        }

        .badge {
            background: #2c2c2e;
            color: var(--text-white);
            font-size: 11px;
            padding: 2px 6px;
            border-radius: 3px;
            margin-left: 6px;
            font-weight: bold;
        }

        .score-box {
            width: 55px;
            height: 100%;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            font-size: 22px;
            font-weight: 900;
            background: #1c1c1e;
        }

        .score-box.team-score {
            border-left: 1px solid #333;
            background: #111;
            color: var(--gold);
            font-size: 18px;
        }

        .score-label {
            font-size: 8px;
            color: var(--text-gray);
            text-transform: uppercase;
            letter-spacing: 0.5px;
            margin-bottom: 2px;
            font-family: Arial, sans-serif;
            font-weight: bold;
        }

        .mid-stats {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            background: #151517;
            height: 100%;
            min-width: 80px;
            border-left: 2px solid #222;
            border-right: 2px solid #222;
        }

        .mid-label {
            font-size: 10px;
            color: var(--text-gray);
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .mid-value {
            font-size: 13px;
            color: var(--gold);
        }

        .shot-clock-block {
            width: 65px;
            height: 100%;
            background: #250000;
            border-left: 2px solid #222;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            color: #ff3b30;
            font-size: 22px;
            font-weight: 900;
        }

        .shot-clock-label {
            font-size: 8px;
            color: #ff8580;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            margin-bottom: 2px;
            font-family: Arial, sans-serif;
            font-weight: bold;
        }

        .shot-clock-block.warning {
            animation: pulse 1s infinite alternate;
            color: #ff453a;
        }

        @keyframes pulse {
            0% { background-color: #250000; }
            100% { background-color: #7a0000; }
        }

        .carousel-block {
            width: 140px;
            height: 100%;
            background: #111;
            border-left: 2px solid #222;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
            position: relative;
        }

        .carousel-block img {
            width: 100%;
            height: 100%;
            object-fit: contain; /* Changed from 'cover' to 'contain' so images scale perfectly inside the slideshow container */
        }

        .hidden {
            display: none !important;
        }
    </style>
</head>
<body>

    <div id="broadcast-banner">
        <div id="event-header">Championship Series - Match 1</div>

        <div class="logo-block" id="logo-box">
            <span id="logo-placeholder" style="font-size:11px; color:#555;">MVP TV</span>
            <img id="logo-img" src="" class="hidden" alt="logo">
        </div>

        <div class="game-icon-block" id="game-icon-box">
            <span id="game-icon-text">🎱</span>
            <img id="game-icon-img" src="" class="hidden" alt="game icon">
        </div>

        <div class="team-section">
            <div class="team-meta">
                <span class="team-name" id="team-a-display">Eastern Team</span>
                <div style="display:flex; align-items:center;">
                    <span class="active-dot" id="dot-a"></span>
                    <span class="player-name" id="player-a-display">M. Vazquez</span>
                    <span class="badge" id="skill-a-display">SL 6</span>
                </div>
            </div>
            <div id="box-score-player-a" class="score-box" style="border-left: 2px solid #222; border-right: 1px solid #333;">
                <span class="score-label">Score</span>
                <span id="score-player-a-display">0</span>
            </div>
            <div id="box-score-team-a" class="score-box team-score">
                <span class="score-label">Match</span>
                <span id="score-team-a-display">0</span>
            </div>
        </div>

        <div id="box-mid-stats" class="mid-stats">
            <span class="mid-label" id="set-title-display">SET 1</span>
            <span class="score-label" style="margin-top: 2px;">Race</span>
            <span class="mid-value" id="race-display">4 to 5</span>
        </div>

        <div class="team-section">
            <div id="box-score-team-b" class="score-box team-score" style="border-right: 1px solid #333;">
                <span class="score-label">Match</span>
                <span id="score-team-b-display">0</span>
            </div>
            <div id="box-score-player-b" class="score-box" style="border-right: 2px solid #222;">
                <span class="score-label">Score</span>
                <span id="score-player-b-display">0</span>
            </div>
            <div class="team-meta">
                <span class="team-name" id="team-b-display">Western Team</span>
                <div style="display:flex; align-items:center;">
                    <span class="active-dot" id="dot-b"></span>
                    <span class="player-name" id="player-b-display">J. Smith</span>
                    <span class="badge" id="skill-b-display">SL 4</span>
                </div>
            </div>
        </div>

        <div id="box-shot-clock" class="shot-clock-block">
            <span class="shot-clock-label">Clock</span>
            <span id="shot-clock-element">30</span>
        </div>

        <div class="carousel-block" id="carousel-box">
            <span id="carousel-placeholder" style="font-size:10px; color:#555; text-align:center;">SPONSORS</span>
            <img id="carousel-img" src="" class="hidden" alt="carousel slide">
        </div>

        <div id="commentator-bar">Booth: M. Vazquez & Co.</div>
    </div>

    <script>
        let carouselImages = [];
        let carouselIndex = 0;
        let carouselIntervalId = null;
        let carouselSpeedMs = 4000;

        window.addEventListener('message', function(event) {
            if (event.data && event.data.type === 'UPDATE_SCOREBOARD') {
                renderOverlay(event.data.data);
            }
        });

        function renderOverlay(state) {
            if (!state) return;

            document.getElementById('event-header').innerText = state.title || "";
            document.getElementById('commentator-bar').innerText = state.comms || "";
            document.getElementById('team-a-display').innerText = state.teamA || "";
            document.getElementById('player-a-display').innerText = state.playerA || "";
            document.getElementById('skill-a-display').innerText = state.skillA || "";
            document.getElementById('team-b-display').innerText = state.teamB || "";
            document.getElementById('player-b-display').innerText = state.playerB || "";
            document.getElementById('skill-b-display').innerText = state.skillB || "";

            // Game Icon / Graphics Render logic for stock vs custom graphics
            const gameTxt = document.getElementById('game-icon-text');
            const gameImg = document.getElementById('game-icon-img');

            if (state.gameSelectionType === 'UPLOAD') {
                gameTxt.classList.add('hidden');
                if (state.gameIcon) {
                    gameImg.src = state.gameIcon;
                    gameImg.classList.remove('hidden');
                } else {
                    gameImg.classList.add('hidden');
                }
            } else {
                gameImg.classList.add('hidden');
                gameTxt.classList.remove('hidden');
                
                // Text fallback mapping
                let fallbackSymbol = "🎱";
                if (state.gameSelectionType === '9ball') fallbackSymbol = "9️⃣";
                if (state.gameSelectionType === '10ball') fallbackSymbol = "🔟";
                if (state.gameSelectionType === 'straight') fallbackSymbol = "🎯";
                
                gameTxt.innerText = fallbackSymbol;
            }

            document.getElementById('score-player-a-display').innerText = state.scorePlayerA;
            document.getElementById('score-player-b-display').innerText = state.scorePlayerB;
            document.getElementById('score-team-a-display').innerText = state.scoreTeamA;
            document.getElementById('score-team-b-display').innerText = state.scoreTeamB;
            document.getElementById('set-title-display').innerText = "SET " + state.setCount;
            document.getElementById('race-display').innerText = state.raceA + " to " + state.raceB;

            const clockEl = document.getElementById('shot-clock-element');
            clockEl.innerText = state.shotClockValue;
            if (state.shotClockValue <= 10 && state.shotClockRunning) {
                clockEl.parentElement.classList.add('warning');
            } else {
                clockEl.parentElement.classList.remove('warning');
            }

            const dotA = document.getElementById('dot-a');
            const dotB = document.getElementById('dot-b');
            if (state.visDots) {
                if (state.activeShooter === 'a') {
                    dotA.classList.add('active');
                    dotB.classList.remove('active');
                } else {
                    dotA.classList.remove('active');
                    dotB.classList.add('active');
                }
            } else {
                dotA.classList.remove('active');
                dotB.classList.remove('active');
            }

            const logoImg = document.getElementById('logo-img');
            const logoPlaceholder = document.getElementById('logo-placeholder');
            if (state.logoData) {
                logoImg.src = state.logoData;
                logoImg.classList.remove('hidden');
                logoPlaceholder.classList.add('hidden');
            } else {
                logoImg.classList.add('hidden');
                logoPlaceholder.classList.remove('hidden');
            }

            if (JSON.stringify(carouselImages) !== JSON.stringify(state.carouselImages) || carouselSpeedMs !== state.carouselSpeed) {
                carouselImages = state.carouselImages || [];
                carouselSpeedMs = state.carouselSpeed || 4000;
                startCarousel();
            }

            // Global visibility toggles
            toggleElement('broadcast-banner', state.visBanner);
            toggleElement('event-header', state.visHeader);
            toggleElement('commentator-bar', state.visComms);
            toggleElement('logo-box', state.visLogo);
            toggleElement('game-icon-box', state.visIcon);
            toggleElement('carousel-box', state.visCarousel);

            // Granular contextual visibility toggles
            toggleElement('box-shot-clock', state.visClock);
            toggleElement('skill-a-display', state.visSkill);
            toggleElement('skill-b-display', state.visSkill);
            toggleElement('set-title-display', state.visSet);
            toggleElement('race-display', state.visRace);
            toggleElement('box-score-player-a', state.visPlayerScores);
            toggleElement('box-score-player-b', state.visPlayerScores);
            toggleElement('box-score-team-a', state.visTeamScores);
            toggleElement('box-score-team-b', state.visTeamScores);

            // Hide the middle structural block entirely if both elements inside it are off
            if (!state.visSet && !state.visRace) {
                document.getElementById('box-mid-stats').classList.add('hidden');
            } else {
                document.getElementById('box-mid-stats').classList.remove('hidden');
            }
        }

        function toggleElement(id, show) {
            const el = document.getElementById(id);
            if (!el) return;
            // Explicitly handles checking for boolean false or undefined flags
            if (show === false) el.classList.add('hidden');
            else el.classList.remove('hidden');
        }

        function startCarousel() {
            if (carouselIntervalId) clearInterval(carouselIntervalId);
            const carouselImg = document.getElementById('carousel-img');
            const placeholder = document.getElementById('carousel-placeholder');

            if (carouselImages.length === 0) {
                carouselImg.classList.add('hidden');
                placeholder.classList.remove('hidden');
                return;
            }

            placeholder.classList.add('hidden');
            carouselImg.classList.remove('hidden');
            carouselIndex = 0;
            carouselImg.src = carouselImages[carouselIndex];

            if (carouselImages.length > 1) {
                carouselIntervalId = setInterval(() => {
                    carouselIndex = (carouselIndex + 1) % carouselImages.length;
                    carouselImg.src = carouselImages[carouselIndex];
                }, carouselSpeedMs);
            }
        }
    </script>
</body>
</html>
